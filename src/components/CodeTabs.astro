---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const { id = "code-tabs" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const snippets = {
    node: `
// 1. Install SDK
import { Rasedi } from 'rasedi-node';

// 2. Initialize
const client = new Rasedi({ 
  apiKey: 'rk_test_...' 
});

// 3. Create Charge
const charge = await client.charges.create({
  amount: 25000,
  currency: 'IQD',
  method: 'zaincash',
  callbackUrl: 'https://yourapp.com/hook'
});
`,
    php: `
// 1. Install via Composer
use Rasedi\\Client;

// 2. Initialize
$client = new Client(['api_key' => 'rk_test_...']);

// 3. Create Charge
$charge = $client->charges->create([
  'amount' => 25000,
  'currency' => 'IQD',
  'method' => 'zaincash',
  'callback_url' => 'https://yourapp.com/hook'
]);
`,
    csharp: `
// 1. Install NuGet Package
using Rasedi.Net;

// 2. Initialize
var client = new RasediClient("rk_test_...");

// 3. Create Charge
var charge = await client.Charges.CreateAsync(new ChargeCreateOptions
{
    Amount = 25000,
    Currency = "IQD",
    Method = "zaincash",
    CallbackUrl = "https://yourapp.com/hook"
});
`,
};
---

<code-tabs
    class="glass block rounded-xl border border-[var(--color-border)] overflow-hidden shadow-xl my-8"
    data-snippets={JSON.stringify(snippets)}
    data-copied-text={t("codetabs.copied")}
>
    <!-- Tab Header -->
    <div
        class="flex items-center bg-[var(--color-surface)] border-b border-[var(--color-border)] overflow-x-auto"
    >
        <button
            class="tab-btn px-6 py-3 text-sm font-mono text-primary border-b-2 border-primary transition-colors hover:bg-[var(--color-surface-hover)]"
            data-tab="node"
        >
            {t("codetabs.label.node")}
        </button>
        <button
            class="tab-btn px-6 py-3 text-sm font-mono text-[var(--color-text-muted)] border-b-2 border-transparent transition-colors hover:text-[var(--color-text-main)] hover:bg-[var(--color-surface-hover)]"
            data-tab="php"
        >
            {t("codetabs.label.php")}
        </button>
        <button
            class="tab-btn px-6 py-3 text-sm font-mono text-white/50 border-b-2 border-transparent transition-colors hover:text-white hover:bg-white/5"
            data-tab="csharp"
        >
            {t("codetabs.label.csharp")}
        </button>
    </div>

    <!-- Code Content -->
    <div
        class="p-6 bg-[#0d1117] font-mono text-sm overflow-x-auto relative group"
    >
        <div
            class="absolute right-4 top-4 opacity-0 group-hover:opacity-100 transition-opacity"
        >
            <button
                class="copy-btn text-xs text-white/40 hover:text-white uppercase tracking-wider"
                >{t("codetabs.copy")}</button
            >
        </div>

        <pre
            class="text-blue-100 min-h-[300px] text-left ltr"
            dir="ltr"><code>{snippets.node.trim()}</code></pre>
    </div>
</code-tabs>

<script>
    class CodeTabs extends HTMLElement {
        constructor() {
            super();

            // Safe JSON parse
            let snippets = {};
            try {
                snippets = JSON.parse(this.dataset.snippets || "{}");
            } catch (e) {
                console.error("Failed to parse snippets", e);
            }

            const tabs = this.querySelectorAll(".tab-btn");
            const codeBlock = this.querySelector("code");
            const copyBtn = this.querySelector(".copy-btn");

            // Tab Switching
            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    // Update Active State
                    tabs.forEach((t) => {
                        t.classList.remove("text-primary", "border-primary");
                        t.classList.add(
                            "text-[var(--color-text-muted)]",
                            "border-transparent",
                        );
                    });
                    tab.classList.remove(
                        "text-[var(--color-text-muted)]",
                        "border-transparent",
                    );
                    tab.classList.add("text-primary", "border-primary");

                    // Update Content
                    const lang = tab.dataset.tab;
                    if (codeBlock && snippets[lang]) {
                        codeBlock.textContent = snippets[lang].trim();
                    }
                });
            });

            // Copy Functionality
            copyBtn?.addEventListener("click", async () => {
                if (!codeBlock) return;
                try {
                    await navigator.clipboard.writeText(
                        codeBlock.textContent || "",
                    );
                    const originalText = copyBtn.textContent;
                    copyBtn.textContent = this.dataset.copiedText || "Copied!";
                    setTimeout(
                        () => (copyBtn.textContent = originalText),
                        2000,
                    );
                } catch (err) {
                    console.error("Failed to copy!", err);
                }
            });
        }
    }

    customElements.define("code-tabs", CodeTabs);
</script>
