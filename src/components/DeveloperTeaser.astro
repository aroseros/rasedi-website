---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const localizePath = (path: string) => {
    if (path.startsWith("http")) return path;
    if (lang === "en") return path;
    return `/${lang}${path}`;
};

const codeSnippet = `
// Initialize the Rasedi Client
const rasedi = new Rasedi({
    apiKey: "rk_live_...",
    region: "iq"
});

// Create a Payment
const payment = await rasedi.payments.create({
    amount: 25000,
    currency: "IQD",
    method: "zaincash",
    description: "Premium Plan"
});
`;
---

<section class="py-32 relative overflow-hidden">
    <!-- Background Decor -->
    <div
        class="absolute right-0 top-1/2 -translate-y-1/2 w-1/2 h-full bg-gradient-to-l from-primary/5 to-transparent blur-3xl -z-10"
    >
    </div>

    <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Content -->
            <div class="flex-1 space-y-8">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] text-xs font-mono text-primary animate-fade-in"
                >
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"
                    ></span>
                    <span>{t("dev.badge")}</span>
                </div>

                <h2 class="text-4xl md:text-5xl font-bold tracking-tight">
                    {t("dev.title.pre")}
                    <span class="text-primary">{t("dev.title.highlight")}</span
                    >{t("dev.title.post")}
                </h2>

                <p
                    class="text-[var(--color-text-muted)] text-lg leading-relaxed max-w-lg"
                >
                    {t("dev.description")}
                </p>

                <ul class="space-y-4">
                    <li
                        class="flex items-center gap-3 text-[var(--color-text-muted)]"
                    >
                        <div
                            class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs"
                        >
                            ✓
                        </div>
                        <span>{t("dev.feature.1")}</span>
                    </li>
                    <li
                        class="flex items-center gap-3 text-[var(--color-text-muted)]"
                    >
                        <div
                            class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs"
                        >
                            ✓
                        </div>
                        <span>{t("dev.feature.2")}</span>
                    </li>
                    <li
                        class="flex items-center gap-3 text-[var(--color-text-muted)]"
                    >
                        <div
                            class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs"
                        >
                            ✓
                        </div>
                        <span>{t("dev.feature.3")}</span>
                    </li>
                </ul>

                <div class="pt-4">
                    <a
                        href={localizePath("/developers")}
                        class="inline-flex items-center gap-2 text-primary font-bold hover:gap-4 transition-all group"
                    >
                        {t("dev.cta")}
                        <span
                            class="text-xl rtl:rotate-180 transition-transform"
                            >→</span
                        >
                    </a>
                </div>
            </div>

            <!-- Visual / Code -->
            <div class="flex-1 w-full max-w-lg relative perspective-1000">
                <div
                    class="glass rounded-2xl border border-[var(--color-border)] overflow-hidden transform rotate-y-6 hover:rotate-y-0 transition-transform duration-700 shadow-2xl"
                >
                    <div
                        class="flex items-center gap-2 px-4 py-3 bg-[var(--color-surface)] border-b border-[var(--color-border)]"
                    >
                        <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500/50">
                        </div>
                        <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
                        <span
                            class="text-xs text-[var(--color-text-muted)] font-mono ml-2"
                            >{t("dev.teaser.file")}</span
                        >
                    </div>
                    <div
                        class="p-6 bg-[#0E0E10] font-mono text-sm overflow-x-auto text-left ltr"
                        dir="ltr"
                    >
                        <!-- Note: Code block always dark for readability, always LTR -->
                        <pre
                            class="text-blue-100"><code set:html={codeSnippet.trim()} /></pre>
                    </div>
                </div>

                <!-- Floating Badge -->
                <div
                    class="absolute -bottom-6 -right-6 glass px-6 py-4 rounded-xl border border-[var(--color-border)] flex items-center gap-3 animate-float"
                >
                    <div class="text-3xl">🚀</div>
                    <div>
                        <div
                            class="text-xs text-[var(--color-text-muted)] uppercase font-bold"
                        >
                            {t("dev.uptime")}
                        </div>
                        <div class="text-primary font-mono font-bold">
                            99.99%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .rotate-y-6 {
        transform: rotateY(-6deg) rotateX(2deg);
    }
</style>
