---
const currentYear = new Date().getFullYear();
---

<footer
    class="relative mt-32 border-t border-white/5 bg-black/40 backdrop-blur-xl"
>
    <!-- Pre-Footer CTA -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 -mt-24 mb-20">
        <div
            class="glass p-12 rounded-3xl text-center border border-white/10 relative overflow-hidden group"
        >
            <!-- Glow Effects -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-gradient-to-b from-primary/5 to-transparent opacity-50 pointer-events-none"
            >
            </div>
            <div
                class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-64 bg-primary/20 blur-[100px] rounded-full group-hover:bg-primary/30 transition-colors duration-700"
            >
            </div>

            <h2 class="text-3xl md:text-5xl font-bold mb-6 relative z-10">
                Ready to monetize in <span class="text-primary">Iraq</span>?
            </h2>
            <p
                class="text-white/60 text-lg mb-10 max-w-2xl mx-auto relative z-10"
            >
                Join 500+ businesses using Rasedi to process payments, automate
                payouts, and scale faster.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10"
            >
                <a
                    href="/contact"
                    class="px-8 py-4 bg-primary text-black font-bold rounded-full hover:shadow-[0_0_40px_rgba(0,220,130,0.3)] transition-all transform hover:scale-105 active:scale-95"
                >
                    Start Integration Now
                </a>
                <a
                    href="/developers"
                    class="px-8 py-4 bg-white/5 border border-white/10 text-white font-bold rounded-full hover:bg-white/10 transition-all"
                >
                    Read Documentation
                </a>
            </div>
        </div>
    </div>

    <!-- Main Footer Content -->
    <div class="max-w-7xl mx-auto px-6 pb-12">
        <div class="grid grid-cols-2 md:grid-cols-12 gap-10 md:gap-8 mb-16">
            <!-- Brand Column -->
            <div class="col-span-2 md:col-span-4 flex flex-col gap-6">
                <a
                    href="/"
                    class="text-2xl font-bold tracking-tight flex items-center gap-2 group w-fit"
                >
                    <span
                        class="text-primary group-hover:shadow-neon transition-all duration-300 rounded-full h-3 w-3 bg-primary block"
                    ></span>
                    Rasedi
                </a>
                <p class="text-white/50 text-sm leading-relaxed max-w-xs">
                    The financial operating system for modern Iraqi commerce.
                    Unified payments, simplified.
                </p>

                <!-- Status Indicator -->
                <div
                    class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 w-fit"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                        ></span>
                    </span>
                    <span class="text-xs font-mono text-white/70"
                        >Systems Operational</span
                    >
                </div>
            </div>

            <!-- Links Column 1: Product -->
            <div class="col-span-1 md:col-span-2 flex flex-col gap-4">
                <h4 class="font-bold text-white">Product</h4>
                <a
                    href="/features"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Features</a
                >
                <a
                    href="/features"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Payment Gateway</a
                >
                <a
                    href="/features"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Payouts</a
                >
                <a
                    href="/features"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Invoicing</a
                >
            </div>

            <!-- Links Column 2: Developers -->
            <div class="col-span-1 md:col-span-2 flex flex-col gap-4">
                <h4 class="font-bold text-white">Developers</h4>
                <a
                    href="/developers"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Documentation</a
                >
                <a
                    href="/developers"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >API Reference</a
                >
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Status Page</a
                >
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Github</a
                >
            </div>

            <!-- Links Column 3: Company -->
            <div class="col-span-1 md:col-span-2 flex flex-col gap-4">
                <h4 class="font-bold text-white">Company</h4>
                <a
                    href="/company"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >About</a
                >
                <a
                    href="/contact"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Contact</a
                >
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Privacy Policy</a
                >
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Terms of Service</a
                >
            </div>

            <!-- Links Column 4: Social -->
            <div class="col-span-1 md:col-span-2 flex flex-col gap-4">
                <h4 class="font-bold text-white">Social</h4>
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Twitter / X</a
                >
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >LinkedIn</a
                >
                <a
                    href="#"
                    class="text-white/50 hover:text-primary transition-colors text-sm"
                    >Instagram</a
                >
            </div>
        </div>

        <div
            class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between gap-4"
        >
            <p class="text-white/30 text-xs">
                &copy; {currentYear} Rasedi Technologies Ltd. All rights reserved.
                <br />
                Registered in Baghdad, Iraq.
            </p>
            <div class="flex gap-6">
                <p class="text-white/30 text-xs font-mono">
                    Designed by <span class="text-white/50"
                        >Radical Minimalism</span
                    >
                </p>
            </div>
        </div>
    </div>
</footer>
