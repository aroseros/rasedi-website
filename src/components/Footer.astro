---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const localizePath = (path: string) => {
    if (path.startsWith("http")) return path;
    if (lang === "en") return path;
    return `/${lang}${path}`;
};
---

<footer
    class="relative mt-32 border-t border-[var(--color-border)] bg-[var(--color-surface)]/40 backdrop-blur-xl"
>
    <!-- Pre-Footer CTA -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 -mt-24 mb-20">
        <div
            class="glass p-12 rounded-3xl text-center border border-[var(--color-border)] relative overflow-hidden group transition-all duration-500 hover:border-primary/20 hover:shadow-[0_0_50px_rgba(0,220,130,0.2)]"
        >
            <!-- Glow Effects -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-gradient-to-b from-primary/5 to-transparent opacity-50 pointer-events-none"
            >
            </div>
            <div
                class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-64 bg-primary/20 blur-[100px] rounded-full group-hover:bg-primary/30 transition-colors duration-700"
            >
            </div>

            <h2 class="text-3xl md:text-5xl font-bold mb-6 relative z-10">
                {t("footer.cta.headline.pre")}
                <span class="text-primary"
                    >{t("footer.cta.headline.highlight")}</span
                >{t("footer.cta.headline.post")}
            </h2>
            <p
                class="text-[var(--color-text-muted)] text-lg mb-10 max-w-2xl mx-auto relative z-10"
            >
                {t("footer.cta.description")}
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10"
            >
                <a
                    href={localizePath("/contact")}
                    class="px-8 py-4 bg-primary text-black font-bold rounded-full hover:shadow-[0_0_40px_rgba(0,220,130,0.3)] transition-all transform hover:scale-105 active:scale-95"
                >
                    {t("footer.cta.start")}
                </a>
                <a
                    href={localizePath("/developers")}
                    class="px-8 py-4 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-main)] font-bold rounded-full hover:bg-[var(--color-surface-hover)] transition-all"
                >
                    {t("footer.cta.docs")}
                </a>
            </div>
        </div>
    </div>

    <!-- Main Footer Content -->
    <div class="max-w-7xl mx-auto px-6 pb-12 flex flex-col gap-20 lg:gap-24">
        <!-- Top Section: Brand & Navigation -->
        <div
            class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-20"
        >
            <!-- Brand Column (Left) -->
            <div class="flex flex-col gap-6 max-w-sm">
                <a
                    href={localizePath("/")}
                    class="text-2xl font-bold tracking-tight flex items-center gap-2 group w-fit"
                >
                    <span
                        class="text-primary group-hover:shadow-neon transition-all duration-300 rounded-full h-3 w-3 bg-primary block"
                    ></span>
                    Rasedi
                </a>
                <p
                    class="text-[var(--color-text-muted)] text-sm leading-relaxed max-w-xs"
                >
                    {t("footer.brand.description")}
                </p>
            </div>

            <!-- Navigation Grid (Right) -->
            <div
                class="grid grid-cols-2 md:grid-cols-3 gap-10 lg:gap-24 text-left"
            >
                <!-- Column 1: Product -->
                <div class="flex flex-col gap-4">
                    <h4 class="font-bold text-[var(--color-text-main)]">
                        {t("footer.col.product")}
                    </h4>
                    <a
                        href={localizePath("/features")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.features")}</a
                    >
                    <a
                        href={localizePath("/features")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.gateway")}</a
                    >
                    <a
                        href={localizePath("/features")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.payouts")}</a
                    >
                    <a
                        href={localizePath("/features")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.invoicing")}</a
                    >
                </div>

                <!-- Column 2: Resources -->
                <div class="flex flex-col gap-4">
                    <h4 class="font-bold text-[var(--color-text-main)]">
                        {t("footer.col.resources")}
                    </h4>
                    <a
                        href={localizePath("/developers")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.docs")}</a
                    >
                    <a
                        href={localizePath("/developers")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.api")}</a
                    >
                    <a
                        href="#"
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.status")}</a
                    >
                    <a
                        href="#"
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.support")}</a
                    >
                </div>

                <!-- Column 3: Company -->
                <div class="flex flex-col gap-4">
                    <h4 class="font-bold text-[var(--color-text-main)]">
                        {t("footer.col.company")}
                    </h4>
                    <a
                        href={localizePath("/company")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.about")}</a
                    >
                    <a
                        href={localizePath("/contact")}
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.contact")}</a
                    >
                    <a
                        href="#"
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.twitter")}</a
                    >
                    <a
                        href="#"
                        class="text-[var(--color-text-muted)] hover:text-primary transition-all duration-300 hover:translate-x-1 text-sm"
                        >{t("footer.link.linkedin")}</a
                    >
                </div>
            </div>
        </div>

        <!-- Bottom Section: Status & Legal -->
        <div
            class="flex flex-col-reverse md:flex-row items-center justify-between gap-6 w-full"
        >
            <!-- Status Indicator (Bottom Left) -->
            <div
                class="flex items-center gap-2 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-full px-4 py-2 hover:border-primary/30 transition-colors"
                title="System Status"
            >
                <span class="relative flex h-2.5 w-2.5">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
                    ></span>
                </span>
                <span
                    class="text-xs font-mono text-[var(--color-text-main)] font-medium"
                    >{t("footer.status")}</span
                >
            </div>

            <!-- Legal (Bottom Right) -->
            <div
                class="flex flex-col md:flex-row items-center gap-4 md:gap-8 text-[var(--color-text-muted)] text-xs"
            >
                <p>
                    &copy; {currentYear}
                    {t("footer.legal.copyright")}
                </p>
                <a href="#" class="hover:text-primary transition-colors"
                    >{t("footer.legal.privacy")}</a
                >
                <a href="#" class="hover:text-primary transition-colors"
                    >{t("footer.legal.terms")}</a
                >
            </div>
        </div>
    </div>
</footer>
