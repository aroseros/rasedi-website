---
import { Image } from "astro:assets";
import step1 from "../assets/journey/step1.png";
import step2 from "../assets/journey/step2.png";
import step3 from "../assets/journey/step3.png";
import step4 from "../assets/journey/step4.png";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-32 relative">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-24">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                {t("journey.title.pre")}
                <span class="text-primary">{t("journey.title.highlight")}</span>
            </h2>
            <p class="text-[var(--color-text-muted)] text-xl max-w-2xl mx-auto">
                {t("journey.description")}
            </p>
        </div>

        <div class="relative">
            <!-- Vertical Line -->
            <div
                class="absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-primary/30 to-transparent hidden md:block overflow-hidden transform -translate-x-1/2"
            >
                <div
                    class="absolute inset-0 w-full h-1/2 bg-gradient-to-b from-transparent via-primary to-transparent animate-data-flow"
                >
                </div>
            </div>

            <!-- Steps -->
            <div class="space-y-32">
                <!-- Step 1: Account -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="glass-card p-8 md:text-end reveal-left order-2 md:order-1 transition-all duration-500 hover:border-primary/40 hover:shadow-[0_0_30px_rgba(0,220,130,0.1)] group"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 text-[var(--color-text-main)] group-hover:text-primary transition-colors"
                        >
                            {t("journey.step.1.title")}
                        </h3>
                        <p class="text-[var(--color-text-muted)]">
                            {t("journey.step.1.desc")}
                        </p>
                    </div>
                    <div
                        class="relative flex justify-center md:justify-start reveal-right order-1 md:order-2"
                    >
                        <div
                            class="journey-number w-12 h-12 bg-[var(--color-surface)] border-2 border-primary/50 rounded-full absolute -left-[26px] rtl:-right-[26px] rtl:left-auto top-1/2 -translate-y-1/2 z-10 hidden md:flex items-center justify-center font-bold text-primary shadow-[0_0_15px_rgba(0,220,130,0.3)]"
                        >
                            1
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative overflow-hidden group hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] flex items-center justify-center bg-black/40"
                        >
                            <Image
                                src={step1}
                                alt="Create Account"
                                class="w-full h-full object-cover opacity-90 group-hover:scale-110 transition-transform duration-700"
                            />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"
                            >
                            </div>
                            <div
                                class="absolute bottom-4 right-4 rtl:right-auto rtl:left-4 px-4 py-1 bg-primary text-black text-xs font-bold rounded-full"
                            >
                                {t("journey.step.1.badge")}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: KYC -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="order-1 md:order-1 relative flex justify-center md:justify-end reveal-left"
                    >
                        <div
                            class="journey-number w-12 h-12 bg-[var(--color-surface)] border-2 border-primary/50 rounded-full absolute -right-[26px] rtl:-left-[26px] rtl:right-auto top-1/2 -translate-y-1/2 z-10 hidden md:flex items-center justify-center font-bold text-primary shadow-[0_0_15px_rgba(0,220,130,0.3)]"
                        >
                            2
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative flex items-center justify-center overflow-hidden hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] bg-black/40"
                        >
                            <Image
                                src={step2}
                                alt="KYC Verification"
                                class="w-full h-full object-cover opacity-90 hover:scale-110 transition-transform duration-700"
                            />
                            <div
                                class="absolute inset-0 flex items-center justify-center bg-black/20 backdrop-blur-[1px]"
                            >
                                <div
                                    class="w-12 h-12 bg-primary/90 rounded-full flex items-center justify-center text-black text-2xl font-bold shadow-lg"
                                >
                                    ✓
                                </div>
                            </div>
                        </div>
                    </div>
                    <div
                        class="order-2 md:order-2 glass-card p-8 reveal-right transition-all duration-500 hover:border-primary/40 hover:shadow-[0_0_30px_rgba(0,220,130,0.1)] group"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 text-[var(--color-text-main)] group-hover:text-primary transition-colors"
                        >
                            {t("journey.step.2.title")}
                        </h3>
                        <p class="text-[var(--color-text-muted)]">
                            {t("journey.step.2.desc")}
                        </p>
                    </div>
                </div>

                <!-- Step 3: Payment Link -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="glass-card p-8 md:text-end reveal-left order-2 md:order-1 transition-all duration-500 hover:border-primary/40 hover:shadow-[0_0_30px_rgba(0,220,130,0.1)] group"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 text-[var(--color-text-main)] group-hover:text-primary transition-colors"
                        >
                            {t("journey.step.3.title")}
                        </h3>
                        <p class="text-[var(--color-text-muted)]">
                            {t("journey.step.3.desc")}
                        </p>
                    </div>
                    <div
                        class="relative flex justify-center md:justify-start reveal-right order-1 md:order-2"
                    >
                        <div
                            class="journey-number w-12 h-12 bg-[var(--color-surface)] border-2 border-primary/50 rounded-full absolute -left-[26px] rtl:-right-[26px] rtl:left-auto top-1/2 -translate-y-1/2 z-10 hidden md:flex items-center justify-center font-bold text-primary shadow-[0_0_15px_rgba(0,220,130,0.3)]"
                        >
                            3
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative flex items-center justify-center hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] overflow-hidden bg-black/40"
                        >
                            <Image
                                src={step3}
                                alt="Payment Link"
                                class="w-full h-full object-cover opacity-90 hover:scale-110 transition-transform duration-700"
                            />
                        </div>
                    </div>
                </div>

                <!-- Step 4: Get Paid -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="order-1 md:order-1 relative flex justify-center md:justify-end reveal-left"
                    >
                        <div
                            class="journey-number w-12 h-12 bg-[var(--color-surface)] border-2 border-primary/50 rounded-full absolute -right-[26px] rtl:-left-[26px] rtl:right-auto top-1/2 -translate-y-1/2 z-10 hidden md:flex items-center justify-center font-bold text-primary shadow-[0_0_15px_rgba(0,220,130,0.3)]"
                        >
                            4
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative flex items-center justify-center overflow-hidden hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] bg-black/40"
                        >
                            <Image
                                src={step4}
                                alt="Get Paid"
                                class="w-full h-full object-cover opacity-90 hover:scale-110 transition-transform duration-700"
                            />
                            <div
                                class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-primary/30 to-transparent flex items-end justify-center pb-4"
                            >
                                <span
                                    class="text-3xl font-bold text-white tracking-widest dropshadow-lg"
                                    >IQD</span
                                >
                            </div>
                        </div>
                    </div>
                    <div
                        class="order-2 md:order-2 glass-card p-8 reveal-right transition-all duration-500 hover:border-primary/40 hover:shadow-[0_0_30px_rgba(0,220,130,0.1)] group"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 text-[var(--color-text-main)] group-hover:text-primary transition-colors"
                        >
                            {t("journey.step.4.title")}
                        </h3>
                        <p class="text-[var(--color-text-muted)]">
                            {t("journey.step.4.desc")}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const isRTL = document.documentElement.dir === "rtl";

    // Animate Left Items (In LTR: From Left -50. In RTL: From Right 50)
    gsap.utils.toArray(".reveal-left").forEach((el: any) => {
        gsap.fromTo(
            el,
            { x: isRTL ? 50 : -50, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el,
                    start: "top 80%",
                },
            },
        );
    });

    // Animate Right Items (In LTR: From Right 50. In RTL: From Left -50)
    gsap.utils.toArray(".reveal-right").forEach((el: any) => {
        gsap.fromTo(
            el,
            { x: isRTL ? -50 : 50, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el,
                    start: "top 80%",
                },
            },
        );
    });
    // Animate Data Pipe
    gsap.to(".animate-data-flow", {
        y: "100%",
        duration: 3,
        repeat: -1,
        ease: "linear",
    });

    // Highlight active step numbers on scroll
    gsap.utils.toArray(".journey-step").forEach((step: any, i) => {
        const number = step.querySelector(".journey-number");
        if (number) {
            ScrollTrigger.create({
                trigger: step,
                start: "top center",
                end: "bottom center",
                onEnter: () =>
                    gsap.to(number, {
                        backgroundColor: "var(--color-primary)",
                        color: "#000",
                        scale: 1.2,
                        duration: 0.3,
                    }),
                onLeave: () =>
                    gsap.to(number, {
                        backgroundColor: "var(--color-surface)",
                        color: "var(--color-primary)",
                        scale: 1,
                        duration: 0.3,
                    }),
                onEnterBack: () =>
                    gsap.to(number, {
                        backgroundColor: "var(--color-primary)",
                        color: "#000",
                        scale: 1.2,
                        duration: 0.3,
                    }),
                onLeaveBack: () =>
                    gsap.to(number, {
                        backgroundColor: "var(--color-surface)",
                        color: "var(--color-primary)",
                        scale: 1,
                        duration: 0.3,
                    }),
            });
        }
    });
</script>

<style>
    /* Custom animation for data flow if JS unused fallback */
    @keyframes data-flow {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(100%);
        }
    }
    .animate-data-flow {
        animation: data-flow 3s linear infinite;
    }
</style>
