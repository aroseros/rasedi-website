---
import { Image } from "astro:assets";
import step1 from "../assets/journey/step1.png";
import step2 from "../assets/journey/step2.png";
import step3 from "../assets/journey/step3.png";
import step4 from "../assets/journey/step4.png";
---

<section class="py-32 relative">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-24">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                How It <span class="text-primary">Works</span>
            </h2>
            <p class="text-white/60 text-xl max-w-2xl mx-auto">
                From zero to revenue in four simple steps.
            </p>
        </div>

        <div class="relative">
            <!-- Vertical Line -->
            <div
                class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-primary/50 to-transparent hidden md:block"
            >
            </div>

            <!-- Steps -->
            <div class="space-y-32">
                <!-- Step 1: Account -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="glass-card p-8 md:text-right reveal-left order-2 md:order-1"
                    >
                        <h3 class="text-2xl font-bold mb-4 text-white">
                            1. Create Merchant Account
                        </h3>
                        <p class="text-white/60">
                            Sign up in seconds. No paperwork required for
                            initial access. Just your email and phone number.
                        </p>
                    </div>
                    <div
                        class="relative flex justify-center md:justify-start reveal-right order-1 md:order-2"
                    >
                        <div
                            class="w-12 h-12 bg-primary rounded-full absolute -left-[30px] top-1/2 -translate-y-1/2 border-4 border-black z-10 hidden md:block flex items-center justify-center font-bold text-black"
                        >
                            1
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative overflow-hidden group hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] flex items-center justify-center bg-black/40"
                        >
                            <Image
                                src={step1}
                                alt="Create Account"
                                class="w-full h-full object-cover opacity-90 group-hover:scale-110 transition-transform duration-700"
                            />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"
                            >
                            </div>
                            <div
                                class="absolute bottom-4 right-4 px-4 py-1 bg-primary text-black text-xs font-bold rounded-full"
                            >
                                Register
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: KYC -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="order-1 md:order-1 relative flex justify-center md:justify-end reveal-left"
                    >
                        <div
                            class="w-12 h-12 bg-primary rounded-full absolute -right-[30px] top-1/2 -translate-y-1/2 border-4 border-black z-10 hidden md:block flex items-center justify-center font-bold text-black"
                        >
                            2
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative flex items-center justify-center overflow-hidden hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] bg-black/40"
                        >
                            <Image
                                src={step2}
                                alt="KYC Verification"
                                class="w-full h-full object-cover opacity-90 hover:scale-110 transition-transform duration-700"
                            />
                            <div
                                class="absolute inset-0 flex items-center justify-center bg-black/20 backdrop-blur-[1px]"
                            >
                                <div
                                    class="w-12 h-12 bg-primary/90 rounded-full flex items-center justify-center text-black text-2xl font-bold shadow-lg"
                                >
                                    ✓
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order-2 md:order-2 glass-card p-8 reveal-right">
                        <h3 class="text-2xl font-bold mb-4 text-white">
                            2. Get KYC Verified
                        </h3>
                        <p class="text-white/60">
                            Automated identity verification. Upload your ID and
                            business registration. Approved in under 24 hours.
                        </p>
                    </div>
                </div>

                <!-- Step 3: Payment Link -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="glass-card p-8 md:text-right reveal-left order-2 md:order-1"
                    >
                        <h3 class="text-2xl font-bold mb-4 text-white">
                            3. Create Payment Link
                        </h3>
                        <p class="text-white/60">
                            Generate a secure link from your dashboard. Set
                            amount, currency, and description. No coding needed.
                        </p>
                    </div>
                    <div
                        class="relative flex justify-center md:justify-start reveal-right order-1 md:order-2"
                    >
                        <div
                            class="w-12 h-12 bg-primary rounded-full absolute -left-[30px] top-1/2 -translate-y-1/2 border-4 border-black z-10 hidden md:block flex items-center justify-center font-bold text-black"
                        >
                            3
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative flex items-center justify-center hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] overflow-hidden bg-black/40"
                        >
                            <Image
                                src={step3}
                                alt="Payment Link"
                                class="w-full h-full object-cover opacity-90 hover:scale-110 transition-transform duration-700"
                            />
                        </div>
                    </div>
                </div>

                <!-- Step 4: Get Paid -->
                <div
                    class="journey-step relative grid md:grid-cols-2 gap-12 items-center"
                >
                    <div
                        class="order-1 md:order-1 relative flex justify-center md:justify-end reveal-left"
                    >
                        <div
                            class="w-12 h-12 bg-primary rounded-full absolute -right-[30px] top-1/2 -translate-y-1/2 border-4 border-black z-10 hidden md:block flex items-center justify-center font-bold text-black"
                        >
                            4
                        </div>
                        <!-- Infograph Image -->
                        <div
                            class="glass rounded-2xl relative flex items-center justify-center overflow-hidden hover:shadow-neon transition-all duration-500 w-[280px] h-[280px] bg-black/40"
                        >
                            <Image
                                src={step4}
                                alt="Get Paid"
                                class="w-full h-full object-cover opacity-90 hover:scale-110 transition-transform duration-700"
                            />
                            <div
                                class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-primary/30 to-transparent flex items-end justify-center pb-4"
                            >
                                <span
                                    class="text-3xl font-bold text-white tracking-widest dropshadow-lg"
                                    >IQD</span
                                >
                            </div>
                        </div>
                    </div>
                    <div class="order-2 md:order-2 glass-card p-8 reveal-right">
                        <h3 class="text-2xl font-bold mb-4 text-white">
                            4. Get Paid
                        </h3>
                        <p class="text-white/60">
                            Funds settle instantly to your Rasedi wallet.
                            Withdraw to your bank or ZainCash anytime.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Animate Left Items
    gsap.utils.toArray(".reveal-left").forEach((el: any) => {
        gsap.fromTo(
            el,
            { x: -50, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el,
                    start: "top 80%",
                },
            },
        );
    });

    // Animate Right Items
    gsap.utils.toArray(".reveal-right").forEach((el: any) => {
        gsap.fromTo(
            el,
            { x: 50, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el,
                    start: "top 80%",
                },
            },
        );
    });
</script>
