---
import { languages } from "../i18n/utils";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<div class="relative group z-50">
    <button
        class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 hover:bg-white/10 transition-colors text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text-main)]"
        aria-label="Select Language"
    >
        <span class="uppercase font-medium">{lang}</span>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:rotate-180 transition-transform duration-300"
        >
            <path d="m6 9 6 6 6-6"></path>
        </svg>
    </button>

    <!-- Dropdown -->
    <div
        class="absolute top-full end-0 mt-2 w-32 py-2 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-glass opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 delay-150 group-hover:delay-0 translate-y-2 group-hover:translate-y-0 before:absolute before:-top-4 before:left-0 before:w-full before:h-4 before:content-['']"
    >
        {
            Object.entries(languages).map(([l, label]) => (
                <a
                    href={`/${l === "en" ? "" : l}`}
                    class:list={[
                        "block px-4 py-2 text-sm transition-colors hover:bg-[var(--color-surface-hover)]",
                        {
                            "text-primary font-bold": l === lang,
                            "text-[var(--color-text-muted)]": l !== lang,
                        },
                    ]}
                >
                    {label}
                </a>
            ))
        }
    </div>
</div>
