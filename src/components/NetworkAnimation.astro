---
import { Image } from "astro:assets";
import walletIcon from "../assets/hero/zaincash.png";
import cardIcon from "../assets/hero/card.png";
import qiIcon from "../assets/hero/qi.png";
import superQiIcon from "../assets/hero/superqi.png";
import nassWalletIcon from "../assets/hero/nasswallet.png";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nodes = [
  { img: walletIcon, alt: "ZainCash", delay: "0s", orbit: "orbit-1", scale: 1 },
  { img: qiIcon, alt: "QI Card", delay: "-2s", orbit: "orbit-2", scale: 1.1 },
  { img: cardIcon, alt: "Visa/Mastercard", delay: "-4s", orbit: "orbit-3", scale: 1.2 },
  { img: superQiIcon, alt: "SuperQi", delay: "-1s", orbit: "orbit-2", scale: 0.9 },
  { img: nassWalletIcon, alt: "Nasswallet", delay: "-3s", orbit: "orbit-1", scale: 0.95 },
];
---

<div class="network-container w-full h-[600px] md:h-[800px] relative flex flex-col items-center justify-center overflow-hidden md:overflow-visible my-8 md:my-0">
  <!-- Headline -->
  <h1 class="absolute top-4 md:top-8 z-30 text-center px-4 w-full">
    <span class="block text-transparent bg-clip-text bg-gradient-to-r from-primary to-purple-400 font-bold text-3xl md:text-6xl tracking-tight mb-2 md:mb-4 drop-shadow-sm">
      {t("network.title.pre")}
    </span>
    <span class="block text-primary/90 font-mono text-xs md:text-xl tracking-[0.2em] md:tracking-[0.4em] uppercase animate-pulse shadow-primary/20 drop-shadow-sm">
      {t("network.title.post")}
    </span>
  </h1>

  <!-- Core Pulse -->
  <div class="absolute z-20">
    <div class="w-32 h-32 bg-primary/20 rounded-full animate-ping opacity-20 absolute inset-0"></div> <!-- Ripple 1 -->
    <div class="w-32 h-32 bg-primary/30 rounded-full animate-pulse-slow blur-xl absolute inset-0"></div>
    <div class="w-32 h-32 bg-[var(--color-surface)] border-4 border-primary/50 rounded-full flex items-center justify-center relative shadow-[0_0_60px_rgba(0,220,130,0.6)] z-20">
      <span class="text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-b from-primary to-emerald-600 drop-shadow-lg">R</span>
    </div>
  </div>

  <!-- Orbits & Nodes -->
  {nodes.map((node) => (
    <div class={`orbit-ring absolute border border-primary/30 opacity-50 rounded-full aspect-square shadow-[0_0_15px_rgba(0,220,130,0.1)] ${node.orbit}`}></div>
    <div 
      class={`orbit-node absolute w-12 h-12 md:w-20 md:h-20 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-2 md:p-3 shadow-[0_0_20px_rgba(0,0,0,0.3)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:scale-110 md:hover:scale-125 transition-all duration-300 flex items-center justify-center animate-orbit ${node.orbit}-path`}
      style={`animation-delay: ${node.delay};`}
      title={node.alt}
    >
        <Image src={node.img} alt={node.alt} class="w-full h-full object-contain drop-shadow-md" />
        <!-- Data Packet Trail -->
        <div class="absolute w-2 h-2 bg-primary rounded-full opacity-0 trail-particle"></div>
    </div>
  ))}

  <!-- Connecting Lines (SVG background) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-20" class:list={{"text-primary": true}}>
    <defs>
      <radialGradient id="grad1" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
        <stop offset="0%" style="stop-color:rgb(0,220,130);stop-opacity:0" />
        <stop offset="100%" style="stop-color:rgb(0,220,130);stop-opacity:0.3" />
      </radialGradient>
    </defs>
    <circle cx="50%" cy="50%" r="40%" fill="url(#grad1)" />
  </svg>
</div>

<style>
  .network-container {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  /* Orbits sizes - Responsive scaling */
  .orbit-1 { width: 280px; height: 280px; }
  .orbit-2 { width: 420px; height: 420px; }
  .orbit-3 { width: 560px; height: 560px; }

  @media (min-width: 768px) {
    .orbit-1 { width: 400px; height: 400px; }
    .orbit-2 { width: 600px; height: 600px; }
    .orbit-3 { width: 800px; height: 800px; }
  }

  /* Orbit Animations */
  @keyframes rotate {
    from { transform: rotate(0deg) translateX(150px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(150px) rotate(-360deg); }
  }
  
  /* Complex Orbital Paths using translate */
  .orbit-1-path { animation: orbit1 20s linear infinite; }
  .orbit-2-path { animation: orbit2 25s linear infinite; }
  .orbit-3-path { animation: orbit3 30s linear infinite; }

  @keyframes orbit1 {
    0% { transform: rotate(0deg) translateX(140px) rotate(0deg); }
    100% { transform: rotate(360deg) translateX(140px) rotate(-360deg); }
  }
  @keyframes orbit2 {
    0% { transform: rotate(120deg) translateX(210px) rotate(-120deg); }
    100% { transform: rotate(480deg) translateX(210px) rotate(-480deg); }
  }
  @keyframes orbit3 {
    0% { transform: rotate(240deg) translateX(280px) rotate(-240deg); }
    100% { transform: rotate(600deg) translateX(280px) rotate(-600deg); }
  }

  @media (min-width: 768px) {
    @keyframes orbit1 {
      0% { transform: rotate(0deg) translateX(200px) rotate(0deg); }
      100% { transform: rotate(360deg) translateX(200px) rotate(-360deg); }
    }
    @keyframes orbit2 {
      0% { transform: rotate(120deg) translateX(300px) rotate(-120deg); }
      100% { transform: rotate(480deg) translateX(300px) rotate(-480deg); }
    }
    @keyframes orbit3 {
      0% { transform: rotate(240deg) translateX(400px) rotate(-240deg); }
      100% { transform: rotate(600deg) translateX(400px) rotate(-600deg); }
    }
  }

  .orbit-node {
    transition: transform 0.3s ease;
  }
  .orbit-node:hover {
    transform: scale(1.2) !important;
    border-color: var(--color-primary);
    z-index: 50;
    cursor: pointer;
  }
  /* Force Rebuild */
</style>
