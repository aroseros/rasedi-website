---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
    return [{ params: { lang: "ar" } }, { params: { lang: "ku" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("meta.title.company")}>
    <Navbar />

    <main class="pt-32 pb-20 px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-5xl font-bold mb-8 text-[var(--color-text-main)]">
                {t("company.title.pre")}<span class="text-primary"
                    >{t("company.title.highlight")}</span
                >
            </h1>

            <p
                class="text-xl text-[var(--color-text-muted)] leading-relaxed mb-12"
            >
                {t("company.description")}
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
                <div
                    class="glass-card p-8 text-start bg-[var(--color-surface)] border border-[var(--color-border)]"
                >
                    <h3
                        class="text-2xl font-bold mb-4 text-[var(--color-text-main)]"
                    >
                        {t("company.dna.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)]">
                        {t("company.dna.description")}
                    </p>
                </div>
                <div
                    class="glass-card p-8 text-start bg-[var(--color-surface)] border border-[var(--color-border)]"
                >
                    <h3
                        class="text-2xl font-bold mb-4 text-[var(--color-text-main)]"
                    >
                        {t("company.promise.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)]">
                        {t("company.promise.description")}
                    </p>
                </div>
            </div>

            <div
                class="glass p-10 rounded-3xl max-w-2xl mx-auto border border-[var(--color-border)] bg-[var(--color-surface)]"
            >
                <h2
                    class="text-3xl font-bold mb-6 text-[var(--color-text-main)]"
                >
                    {t("company.contact.title")}
                </h2>
                <p class="text-[var(--color-text-muted)] mb-8">
                    {t("company.contact.subtitle")}
                </p>

                <form class="space-y-4 text-start">
                    <div>
                        <label
                            class="block text-sm font-medium text-[var(--color-text-muted)] mb-2"
                            >{t("company.form.email")}</label
                        >
                        <input
                            type="email"
                            placeholder="you@company.com"
                            class="w-full bg-[var(--color-surface-hover)] border border-[var(--color-border)] rounded-lg px-4 py-3 text-[var(--color-text-main)] focus:outline-none focus:border-primary transition-colors placeholder:text-[var(--color-text-muted)]/50"
                        />
                    </div>
                    <div>
                        <label
                            class="block text-sm font-medium text-[var(--color-text-muted)] mb-2"
                            >{t("company.form.message")}</label
                        >
                        <textarea
                            rows="4"
                            placeholder="How can we help?"
                            class="w-full bg-[var(--color-surface-hover)] border border-[var(--color-border)] rounded-lg px-4 py-3 text-[var(--color-text-main)] focus:outline-none focus:border-primary transition-colors placeholder:text-[var(--color-text-muted)]/50"
                        ></textarea>
                    </div>
                    <button
                        class="w-full bg-primary text-black font-bold py-4 rounded-lg hover:shadow-neon transition-all"
                    >
                        {t("company.form.send")}
                    </button>
                </form>
            </div>
        </div>
    </main>
</Layout>
