---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
    return [{ params: { lang: "ar" } }, { params: { lang: "ku" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("meta.title.developers")}>
    <Navbar />

    <main class="pt-32 pb-20 px-4">
        <!-- Hero Section -->
        <div class="max-w-7xl mx-auto mb-32">
            <div class="flex flex-col lg:flex-row gap-16 items-start">
                <div class="flex-1 pt-10">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm mb-8 font-mono"
                    >
                        <span
                            class="w-2 h-2 bg-primary rounded-full animate-pulse"
                        ></span>
                        v2.1 API Live
                    </div>

                    <h1
                        class="text-5xl md:text-7xl font-bold mb-8 tracking-tight text-[var(--color-text-main)]"
                    >
                        {t("developers.hero.title.pre")}
                        <br />
                        <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-500"
                            >{t("developers.hero.title.highlight")}</span
                        >
                    </h1>

                    <p
                        class="text-[var(--color-text-muted)] text-lg md:text-xl mb-12 leading-relaxed max-w-lg"
                    >
                        {t("developers.hero.description")}
                    </p>

                    <div class="flex flex-wrap gap-4">
                        <a
                            href="https://docs.pallawan.com"
                            class="px-8 py-4 bg-primary text-black font-bold rounded-full hover:shadow-[0_0_30px_rgba(0,220,130,0.4)] transition-all"
                        >
                            {t("developers.cta.keys")}
                        </a>
                        <a
                            href="#sandbox"
                            class="px-8 py-4 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-main)] font-bold rounded-full hover:bg-[var(--color-surface-hover)] transition-all"
                        >
                            {t("developers.cta.test")}
                        </a>
                    </div>
                </div>

                <!-- Multi-Language Code Block -->
                <div class="flex-1 w-full lg:max-w-2xl">
                    <CodeTabs />
                </div>
            </div>
        </div>

        <!-- Quickstart Map -->
        <section class="mb-32">
            <h2
                class="text-3xl font-bold text-center mb-16 text-[var(--color-text-main)]"
            >
                {t("developers.flow.title")}
            </h2>
            <div
                class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8"
            >
                <!-- Step 1 -->
                <div
                    class="glass p-8 rounded-3xl border border-[var(--color-border)] relative group hover:-translate-y-2 transition-transform duration-300"
                >
                    <div
                        class="absolute -top-6 start-8 w-12 h-12 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl flex items-center justify-center font-mono text-xl text-primary font-bold z-10 shadow-lg"
                    >
                        1
                    </div>
                    <h3
                        class="text-xl font-bold mt-4 mb-3 text-[var(--color-text-main)]"
                    >
                        {t("developers.flow.step1.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.flow.step1.desc")}
                    </p>
                </div>
                <!-- Step 2 -->
                <div
                    class="glass p-8 rounded-3xl border border-[var(--color-border)] relative group hover:-translate-y-2 transition-transform duration-300"
                >
                    <div
                        class="absolute -top-6 start-8 w-12 h-12 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl flex items-center justify-center font-mono text-xl text-primary font-bold z-10 shadow-lg"
                    >
                        2
                    </div>
                    <h3
                        class="text-xl font-bold mt-4 mb-3 text-[var(--color-text-main)]"
                    >
                        {t("developers.flow.step2.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.flow.step2.desc")}
                    </p>
                </div>
                <!-- Step 3 -->
                <div
                    class="glass p-8 rounded-3xl border border-[var(--color-border)] relative group hover:-translate-y-2 transition-transform duration-300"
                >
                    <div
                        class="absolute -top-6 start-8 w-12 h-12 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl flex items-center justify-center font-mono text-xl text-primary font-bold z-10 shadow-lg"
                    >
                        3
                    </div>
                    <h3
                        class="text-xl font-bold mt-4 mb-3 text-[var(--color-text-main)]"
                    >
                        {t("developers.flow.step3.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.flow.step3.desc")}
                    </p>
                </div>
            </div>
        </section>

        <!-- API Capabilities Grid -->
        <section class="mb-32">
            <h2
                class="text-3xl font-bold text-center mb-4 text-[var(--color-text-main)]"
            >
                {t("developers.capabilities.title")}
            </h2>
            <p class="text-[var(--color-text-muted)] text-center mb-16">
                {t("developers.capabilities.description")}
            </p>

            <div
                class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
            >
                <!-- Card 1 -->
                <div
                    class="p-8 rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/50 transition-colors"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center text-purple-400 mb-6 text-2xl"
                    >
                        ⚡
                    </div>
                    <h3
                        class="text-lg font-bold mb-2 text-[var(--color-text-main)]"
                    >
                        {t("developers.cap.webhooks.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.cap.webhooks.desc")}
                    </p>
                </div>
                <!-- Card 2 -->
                <div
                    class="p-8 rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/50 transition-colors"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 mb-6 text-2xl"
                    >
                        🔒
                    </div>
                    <h3
                        class="text-lg font-bold mb-2 text-[var(--color-text-main)]"
                    >
                        {t("developers.cap.vault.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.cap.vault.desc")}
                    </p>
                </div>
                <!-- Card 3 -->
                <div
                    class="p-8 rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/50 transition-colors"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 mb-6 text-2xl"
                    >
                        🧪
                    </div>
                    <h3
                        class="text-lg font-bold mb-2 text-[var(--color-text-main)]"
                    >
                        {t("developers.cap.sandbox.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.cap.sandbox.desc")}
                    </p>
                </div>
                <!-- Card 4 -->
                <div
                    class="p-8 rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/50 transition-colors"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-yellow-500/20 flex items-center justify-center text-yellow-400 mb-6 text-2xl"
                    >
                        ↩️
                    </div>
                    <h3
                        class="text-lg font-bold mb-2 text-[var(--color-text-main)]"
                    >
                        {t("developers.cap.refunds.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.cap.refunds.desc")}
                    </p>
                </div>
                <!-- Card 5 -->
                <div
                    class="p-8 rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/50 transition-colors"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-red-500/20 flex items-center justify-center text-red-400 mb-6 text-2xl"
                    >
                        🔗
                    </div>
                    <h3
                        class="text-lg font-bold mb-2 text-[var(--color-text-main)]"
                    >
                        {t("developers.cap.links.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.cap.links.desc")}
                    </p>
                </div>
                <!-- Card 6 -->
                <div
                    class="p-8 rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/50 transition-colors"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-orange-500/20 flex items-center justify-center text-orange-400 mb-6 text-2xl"
                    >
                        📜
                    </div>
                    <h3
                        class="text-lg font-bold mb-2 text-[var(--color-text-main)]"
                    >
                        {t("developers.cap.logs.title")}
                    </h3>
                    <p class="text-[var(--color-text-muted)] text-sm">
                        {t("developers.cap.logs.desc")}
                    </p>
                </div>
            </div>
        </section>

        <!-- Sandbox Tools -->
        <section id="sandbox" class="max-w-4xl mx-auto">
            <div
                class="glass p-10 rounded-3xl border border-[var(--color-border)]"
            >
                <div class="flex items-center justify-between mb-8">
                    <div>
                        <h2
                            class="text-2xl font-bold mb-2 text-[var(--color-text-main)]"
                        >
                            🧪 Test Data
                        </h2>
                        <p class="text-[var(--color-text-muted)]">
                            Use these values in Sandbox mode to trigger specific
                            scenarions.
                        </p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b border-[var(--color-border)]">
                                <th
                                    class="pb-4 font-mono text-sm text-[var(--color-text-muted)] uppercase"
                                    >Scenario</th
                                >
                                <th
                                    class="pb-4 font-mono text-sm text-[var(--color-text-muted)] uppercase"
                                    >Value</th
                                >
                                <th
                                    class="pb-4 font-mono text-sm text-[var(--color-text-muted)] uppercase"
                                    >Description</th
                                >
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--color-border)]">
                            <tr>
                                <td class="py-4 text-green-500 font-bold"
                                    >Success</td
                                >
                                <td
                                    class="py-4 font-mono bg-[var(--color-surface)] rounded px-2 text-[var(--color-text-main)]"
                                    >4242 4242 4242 4242</td
                                >
                                <td
                                    class="py-4 text-[var(--color-text-muted)] text-sm"
                                    >Standard localized VISA card success.</td
                                >
                            </tr>
                            <tr>
                                <td class="py-4 text-red-500 font-bold"
                                    >Decline</td
                                >
                                <td
                                    class="py-4 font-mono bg-[var(--color-surface)] rounded px-2 text-[var(--color-text-main)]"
                                    >4000 0566 5566 5556</td
                                >
                                <td
                                    class="py-4 text-[var(--color-text-muted)] text-sm"
                                    >Generic bank decline.</td
                                >
                            </tr>
                            <tr>
                                <td class="py-4 text-yellow-500 font-bold"
                                    >Insufficient Funds</td
                                >
                                <td
                                    class="py-4 font-mono bg-[var(--color-surface)] rounded px-2 text-[var(--color-text-main)]"
                                    >4000 0000 0000 0002</td
                                >
                                <td
                                    class="py-4 text-[var(--color-text-muted)] text-sm"
                                    >Returns `insufficient_funds` error.</td
                                >
                            </tr>
                            <tr>
                                <td class="py-4 text-primary font-bold"
                                    >Magic Amount</td
                                >
                                <td
                                    class="py-4 font-mono bg-[var(--color-surface)] rounded px-2 text-[var(--color-text-main)]"
                                    >1,000 IQD</td
                                >
                                <td
                                    class="py-4 text-[var(--color-text-muted)] text-sm"
                                    >Always succeeds, regardless of card.</td
                                >
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</Layout>
