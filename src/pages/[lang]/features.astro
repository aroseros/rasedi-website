---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { Image } from "astro:assets";
import unifiedPaymentsImg from "../../assets/features/unified-payments.png";
import instantPayoutsImg from "../../assets/features/instant-payouts.png";
import paymentLinksImg from "../../assets/features/payment-links.png";
import smartInvoicingImg from "../../assets/features/smart-invoicing.png";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
    return [{ params: { lang: "ar" } }, { params: { lang: "ku" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("meta.title.features")}>
    <Navbar />

    <main class="pt-32 pb-20 px-4">
        <div class="max-w-6xl mx-auto">
            <header class="text-center mb-32">
                <h1
                    class="text-5xl md:text-6xl font-bold mb-6 tracking-tight text-[var(--color-text-main)]"
                >
                    {t("features.hero.title.pre")}
                    <span class="text-primary"
                        >{t("features.hero.title.highlight")}</span
                    >
                </h1>
                <p
                    class="text-[var(--color-text-muted)] text-xl max-w-2xl mx-auto"
                >
                    {t("features.hero.description")}
                </p>
            </header>

            <!-- FEATURE 1: UNIFIED PAYMENTS (Deep Dive) -->
            <section class="mb-32">
                <div
                    class="glass border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-2xl"
                >
                    <div class="grid lg:grid-cols-2 gap-0">
                        <!-- Visual -->
                        <div
                            class="bg-[var(--color-surface)]/80 relative min-h-[400px] flex items-center justify-center p-8 group overflow-hidden"
                        >
                            <div
                                class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-transparent opacity-50"
                            >
                            </div>
                            <!-- Glow Effect behind image -->
                            <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-primary/20 blur-[100px] rounded-full"
                            >
                            </div>

                            <Image
                                src={unifiedPaymentsImg}
                                alt="Unified Payment Architecture"
                                class="relative z-10 w-full max-w-md object-contain transform group-hover:scale-105 transition-transform duration-700 drop-shadow-2xl"
                            />
                        </div>

                        <!-- Content -->
                        <div class="p-10 lg:p-16 flex flex-col justify-center">
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center border border-primary/20"
                                >
                                    <span class="text-primary text-xl">💳</span>
                                </div>
                                <span
                                    class="text-primary font-mono text-sm tracking-wider uppercase"
                                    >{t("features.f1.badge")}</span
                                >
                            </div>

                            <h2
                                class="text-4xl font-bold mb-6 text-[var(--color-text-main)]"
                            >
                                {t("features.f1.title")}
                            </h2>
                            <p
                                class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8"
                            >
                                {t("features.f1.desc")}
                            </p>

                            <div class="space-y-4 mb-10">
                                <div
                                    class="flex items-center gap-4 p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/30 transition-colors"
                                >
                                    <div class="text-2xl">📱</div>
                                    <div>
                                        <div
                                            class="font-bold text-[var(--color-text-main)]"
                                        >
                                            {t("features.f1.sub.wallets.title")}
                                        </div>
                                        <div
                                            class="text-sm text-[var(--color-text-muted)]"
                                        >
                                            {t("features.f1.sub.wallets.desc")}
                                        </div>
                                    </div>
                                </div>
                                <div
                                    class="flex items-center gap-4 p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-primary/30 transition-colors"
                                >
                                    <div class="text-2xl">💳</div>
                                    <div>
                                        <div
                                            class="font-bold text-[var(--color-text-main)]"
                                        >
                                            {t("features.f1.sub.cards.title")}
                                        </div>
                                        <div
                                            class="text-sm text-[var(--color-text-muted)]"
                                        >
                                            {t("features.f1.sub.cards.desc")}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <a
                                href="#"
                                class="inline-flex items-center text-primary font-bold hover:text-[var(--color-text-main)] transition-colors"
                            >
                                {t("features.f1.cta")} →
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FEATURE 2: INSTANT PAYOUTS (Deep Dive) -->
            <section class="mb-32">
                <div
                    class="glass border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-2xl"
                >
                    <div class="grid lg:grid-cols-2 gap-0">
                        <!-- Content (Left this time for visual balance) -->
                        <div
                            class="order-2 lg:order-1 p-10 lg:p-16 flex flex-col justify-center"
                        >
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center border border-primary/20"
                                >
                                    <span class="text-primary text-xl">⚡</span>
                                </div>
                                <span
                                    class="text-primary font-mono text-sm tracking-wider uppercase"
                                    >{t("features.f2.badge")}</span
                                >
                            </div>

                            <h2
                                class="text-4xl font-bold mb-6 text-[var(--color-text-main)]"
                            >
                                {t("features.f2.title")}
                            </h2>
                            <p
                                class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8"
                            >
                                {t("features.f2.desc")}
                            </p>

                            <ul
                                class="space-y-4 mb-10 text-lg text-[var(--color-text-muted)]"
                            >
                                <li class="flex items-center gap-3">
                                    <span class="text-primary">✓</span>
                                    <span>{t("features.f2.list.1")}</span>
                                </li>
                                <li class="flex items-center gap-3">
                                    <span class="text-primary">✓</span>
                                    <span>{t("features.f2.list.2")}</span>
                                </li>
                                <li class="flex items-center gap-3">
                                    <span class="text-primary">✓</span>
                                    <span>{t("features.f2.list.3")}</span>
                                </li>
                            </ul>

                            <a
                                href="#"
                                class="inline-flex items-center text-primary font-bold hover:text-[var(--color-text-main)] transition-colors"
                            >
                                {t("features.f2.cta")} →
                            </a>
                        </div>

                        <!-- Visual -->
                        <div
                            class="order-1 lg:order-2 bg-[var(--color-surface)]/80 relative min-h-[400px] flex items-center justify-center p-8 group overflow-hidden"
                        >
                            <div
                                class="absolute inset-0 bg-gradient-to-bl from-primary/10 via-transparent to-transparent opacity-50"
                            >
                            </div>
                            <!-- Glow Effect -->
                            <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-primary/10 blur-[100px] rounded-full"
                            >
                            </div>

                            <Image
                                src={instantPayoutsImg}
                                alt="Instant Payouts"
                                class="relative z-10 w-full max-w-md object-contain transform group-hover:scale-105 transition-transform duration-700 drop-shadow-2xl"
                            />
                        </div>
                    </div>
                </div>
            </section>

            <!-- FEATURE 3: PAYMENT LINKS (Deep Dive) -->
            <section class="mb-32">
                <div
                    class="glass border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-2xl"
                >
                    <div class="grid lg:grid-cols-2 gap-0">
                        <!-- Visual -->
                        <div
                            class="bg-[var(--color-surface)]/80 relative min-h-[400px] flex items-center justify-center p-8 group overflow-hidden"
                        >
                            <div
                                class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-transparent opacity-50"
                            >
                            </div>
                            <!-- Glow Effect -->
                            <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-purple-500/10 blur-[100px] rounded-full"
                            >
                            </div>

                            <Image
                                src={paymentLinksImg}
                                alt="Payment Links"
                                class="relative z-10 w-full max-w-md object-contain transform group-hover:scale-105 transition-transform duration-700 drop-shadow-2xl"
                            />
                        </div>

                        <!-- Content -->
                        <div class="p-10 lg:p-16 flex flex-col justify-center">
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center border border-primary/20"
                                >
                                    <span class="text-primary text-xl">🔗</span>
                                </div>
                                <span
                                    class="text-primary font-mono text-sm tracking-wider uppercase"
                                    >{t("features.f3.badge")}</span
                                >
                            </div>

                            <h2
                                class="text-4xl font-bold mb-6 text-[var(--color-text-main)]"
                            >
                                {t("features.f3.title")}
                            </h2>
                            <p
                                class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8"
                            >
                                {t("features.f3.desc")}
                            </p>

                            <div class="grid grid-cols-2 gap-4 mb-10">
                                <div
                                    class="p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)]"
                                >
                                    <div
                                        class="text-[var(--color-text-main)] font-bold mb-1"
                                    >
                                        {t("features.f3.card.fixed.title")}
                                    </div>
                                    <div
                                        class="text-[var(--color-text-muted)] text-sm"
                                    >
                                        {t("features.f3.card.fixed.desc")}
                                    </div>
                                </div>
                                <div
                                    class="p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)]"
                                >
                                    <div
                                        class="text-[var(--color-text-main)] font-bold mb-1"
                                    >
                                        {t("features.f3.card.open.title")}
                                    </div>
                                    <div
                                        class="text-[var(--color-text-muted)] text-sm"
                                    >
                                        {t("features.f3.card.open.desc")}
                                    </div>
                                </div>
                            </div>

                            <a
                                href="#"
                                class="inline-flex items-center text-primary font-bold hover:text-[var(--color-text-main)] transition-colors"
                            >
                                {t("features.f3.cta")} →
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FEATURE 4: SMART INVOICING (Deep Dive) -->
            <section class="mb-32">
                <div
                    class="glass border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-2xl"
                >
                    <div class="grid lg:grid-cols-2 gap-0">
                        <!-- Content (Left for balance) -->
                        <div
                            class="order-2 lg:order-1 p-10 lg:p-16 flex flex-col justify-center"
                        >
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center border border-primary/20"
                                >
                                    <span class="text-primary text-xl">📄</span>
                                </div>
                                <span
                                    class="text-primary font-mono text-sm tracking-wider uppercase"
                                    >{t("features.f4.badge")}</span
                                >
                            </div>

                            <h2
                                class="text-4xl font-bold mb-6 text-[var(--color-text-main)]"
                            >
                                {t("features.f4.title")}
                            </h2>
                            <p
                                class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-8"
                            >
                                {t("features.f4.desc")}
                            </p>

                            <div class="space-y-4 mb-10">
                                <div
                                    class="p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl flex items-center justify-between"
                                >
                                    <span class="text-[var(--color-text-main)]"
                                        >Invoice #1024</span
                                    >
                                    <span
                                        class="text-primary bg-primary/10 px-3 py-1 rounded-full text-xs font-bold"
                                        >PAID (ZainCash)</span
                                    >
                                </div>
                                <div
                                    class="p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl flex items-center justify-between opacity-60"
                                >
                                    <span class="text-[var(--color-text-main)]"
                                        >Invoice #1025</span
                                    >
                                    <span
                                        class="text-yellow-400 bg-yellow-400/10 px-3 py-1 rounded-full text-xs font-bold"
                                        >PENDING</span
                                    >
                                </div>
                            </div>

                            <a
                                href="#"
                                class="inline-flex items-center text-primary font-bold hover:text-[var(--color-text-main)] transition-colors"
                            >
                                {t("features.f4.cta")} →
                            </a>
                        </div>

                        <!-- Visual -->
                        <div
                            class="order-1 lg:order-2 bg-[var(--color-surface)]/80 relative min-h-[400px] flex items-center justify-center p-8 group overflow-hidden"
                        >
                            <div
                                class="absolute inset-0 bg-gradient-to-bl from-primary/10 via-transparent to-transparent opacity-50"
                            >
                            </div>
                            <!-- Glow Effect -->
                            <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-green-500/10 blur-[100px] rounded-full"
                            >
                            </div>

                            <Image
                                src={smartInvoicingImg}
                                alt="Smart Invoicing"
                                class="relative z-10 w-full max-w-md object-contain transform group-hover:scale-105 transition-transform duration-700 drop-shadow-2xl"
                            />
                        </div>
                    </div>
                </div>
            </section>

            <!-- Enterprise Section -->
            <section
                class="mt-32 glass rounded-3xl p-12 relative overflow-hidden shadow-2xl"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-r from-primary/10 to-transparent pointer-events-none"
                >
                </div>
                <div
                    class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10"
                >
                    <div>
                        <h2
                            class="text-3xl md:text-4xl font-bold mb-4 text-[var(--color-text-main)]"
                        >
                            {t("features.enterprise.title")}
                        </h2>
                        <p
                            class="text-[var(--color-text-muted)] text-lg max-w-xl"
                        >
                            {t("features.enterprise.desc")}
                        </p>
                    </div>
                    <div class="flex gap-4">
                        <div
                            class="px-6 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] font-mono text-primary text-sm shadow-sm"
                        >
                            AES-256 ENCRYPTED
                        </div>
                        <div
                            class="px-6 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] font-mono text-primary text-sm shadow-sm"
                        >
                            PCI-DSS READY
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</Layout>
