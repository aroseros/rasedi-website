---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Company | Rasedi">
    <Navbar />

    <main class="pt-32 pb-20 px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-5xl font-bold mb-8 text-[var(--color-text-main)]">
                Building the Financial Infrastructure of <span
                    class="text-primary">Iraq</span
                >
            </h1>

            <p
                class="text-xl text-[var(--color-text-muted)] leading-relaxed mb-12"
            >
                Rasedi is not just a payment gateway. We are an operating system
                for the modern Iraqi economy. Our mission is to bridge the gap
                between local cash traditions and the global digital economy.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
                <div
                    class="glass-card p-8 text-left bg-[var(--color-surface)] border border-[var(--color-border)]"
                >
                    <h3
                        class="text-2xl font-bold mb-4 text-[var(--color-text-main)]"
                    >
                        Our DNA
                    </h3>
                    <p class="text-[var(--color-text-muted)]">
                        We combine Silicon Valley engineering standards with
                        deep local market expertise. We understand that Baghdad
                        is not Berlin, and we build specifically for our
                        context.
                    </p>
                </div>
                <div
                    class="glass-card p-8 text-left bg-[var(--color-surface)] border border-[var(--color-border)]"
                >
                    <h3
                        class="text-2xl font-bold mb-4 text-[var(--color-text-main)]"
                    >
                        Our Promise
                    </h3>
                    <p class="text-[var(--color-text-muted)]">
                        Reliability above all. When money is moving, "works most
                        of the time" is not enough. We aim for 99.99% uptime and
                        instant settlement.
                    </p>
                </div>
            </div>

            <div
                class="glass p-10 rounded-3xl max-w-2xl mx-auto border border-[var(--color-border)] bg-[var(--color-surface)]"
            >
                <h2
                    class="text-3xl font-bold mb-6 text-[var(--color-text-main)]"
                >
                    Contact Us
                </h2>
                <p class="text-[var(--color-text-muted)] mb-8">
                    Enterprises and partners, let's talk.
                </p>

                <form class="space-y-4 text-left">
                    <div>
                        <label
                            class="block text-sm font-medium text-[var(--color-text-muted)] mb-2"
                            >Email</label
                        >
                        <input
                            type="email"
                            placeholder="you@company.com"
                            class="w-full bg-[var(--color-surface-hover)] border border-[var(--color-border)] rounded-lg px-4 py-3 text-[var(--color-text-main)] focus:outline-none focus:border-primary transition-colors placeholder:text-[var(--color-text-muted)]/50"
                        />
                    </div>
                    <div>
                        <label
                            class="block text-sm font-medium text-[var(--color-text-muted)] mb-2"
                            >Message</label
                        >
                        <textarea
                            rows="4"
                            placeholder="How can we help?"
                            class="w-full bg-[var(--color-surface-hover)] border border-[var(--color-border)] rounded-lg px-4 py-3 text-[var(--color-text-main)] focus:outline-none focus:border-primary transition-colors placeholder:text-[var(--color-text-muted)]/50"
                        ></textarea>
                    </div>
                    <button
                        class="w-full bg-primary text-black font-bold py-4 rounded-lg hover:shadow-neon transition-all"
                    >
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </main>
</Layout>
