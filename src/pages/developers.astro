---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

const codeSnippet = `
import { Rasedi } from 'miropay-sdk';

const client = new Rasedi({
  apiKey: process.env.RASEDI_KEY,
  secret: process.env.RASEDI_SECRET
});

// Create a payment session
const session = await client.payments.create({
  amount: 50000,
  currency: 'IQD',
  orderId: 'ORD-123-XML',
  description: 'Premium Subscription',
  callbackUrl: 'https://api.myapp.com/webhook'
});

console.log(session.checkoutUrl);
`;
---

<Layout title="Developers | Rasedi">
    <Navbar />

    <main class="pt-32 pb-20 px-4">
        <div
            class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-16 items-start"
        >
            <!-- Content -->
            <div class="flex-1">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm mb-8 font-mono"
                >
                    v2.0.0 Stable
                </div>

                <h1 class="text-5xl font-bold mb-6 tracking-tight">
                    Built for <br /><span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400"
                        >Builders</span
                    >
                </h1>

                <p class="text-white/60 text-lg mb-10 leading-relaxed">
                    We hated legacy banking APIs, so we built the one we wanted
                    to use. Predictable REST endpoints, typed SDKs, and granular
                    webhooks.
                </p>

                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 shrink-0"
                        >
                            <span class="text-primary font-bold">1</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-xl mb-1">
                                RESTful & Typesafe
                            </h3>
                            <p class="text-white/50">
                                Standard HTTP verbs and TypeScript definitions
                                out of the box.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 shrink-0"
                        >
                            <span class="text-primary font-bold">2</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-xl mb-1">
                                Webhooks Engine
                            </h3>
                            <p class="text-white/50">
                                Real-time events for payment success, failure,
                                and refunds.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center border border-white/10 shrink-0"
                        >
                            <span class="text-primary font-bold">3</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-xl mb-1">
                                Sandbox Environment
                            </h3>
                            <p class="text-white/50">
                                Test with fake money. Zero risk, full feature
                                parity.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-12 flex gap-4">
                    <a
                        href="https://docs.pallawan.com"
                        target="_blank"
                        class="px-6 py-3 rounded-full bg-white/10 text-white font-bold border border-white/10 hover:bg-white/20 transition-all"
                    >
                        Read Documentation
                    </a>
                    <a
                        href="#"
                        class="px-6 py-3 rounded-full text-white/70 hover:text-white transition-all"
                    >
                        View on GitHub →
                    </a>
                </div>
            </div>

            <!-- Code Column -->
            <div class="flex-1 w-full lg:max-w-xl">
                <div class="glass-card overflow-hidden">
                    <div
                        class="flex items-center justify-between px-4 py-3 border-b border-white/5 bg-black/40"
                    >
                        <div class="flex gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500/50">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/50">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-500/50">
                            </div>
                        </div>
                        <span class="text-xs text-white/30 font-mono"
                            >payment-flow.ts</span
                        >
                    </div>
                    <div class="p-6 bg-black/80 overflow-x-auto">
                        <pre
                            class="font-mono text-sm leading-relaxed text-blue-100"><code set:html={codeSnippet.trim().replace(/\n/g, '<br/>').replace(/\s/g, '&nbsp;')} /></pre>
                        <!-- Note: The quick regex replace above is a hack for the raw string. 
                     In a real app we'd use a syntax highlighter library or the previous span-based approach. 
                     Reverting to span approach for cleaner highlighting below. -->
                    </div>
                </div>

                <!-- Terminal Output simulation -->
                <div
                    class="mt-6 glass-card p-4 font-mono text-xs text-green-400 bg-black"
                >
                    <div class="mb-2 opacity-50">$ node payment-flow.js</div>
                    <div>> Processing payment ORD-123-XML...</div>
                    <div>
                        > Session created:
                        https://checkout.rasedi.com/pay/session_8x92...
                    </div>
                    <div class="animate-pulse">> Waiting for user...</div>
                </div>
            </div>
        </div>
    </main>
</Layout>
